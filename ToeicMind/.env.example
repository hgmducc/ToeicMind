# Copy to .env for local Development. Keep real values out of Git.
ConnectionStrings__DefaultConnection='Server=localhost;Database=ToeicDb;Trusted_Connection=True;TrustServerCertificate=True'
Jwt__Key=''
# JWT defaults are in appsettings*.json. Uncomment to override them.
# Jwt__Issuer='ToeicMindApiDev'
# Jwt__Audience='ToeicMindClientDev'
# Jwt__ExpireMinutes='60'
# Jwt__RefreshTokenDays='7'

Email__SmtpHost='smtp.gmail.com'
Email__SmtpPort='587'
Email__SenderName='ToeicMind'
Email__SenderEmail=''
Email__Username=''
Email__Password=''
Email__EnableSsl='true'

# ID token verification only uses the client ID. No client secret is needed.
Google__ClientId=''

# Cloudflare R2 S3 API. Real credentials only in local/hosting secrets.
R2__Endpoint=''
R2__BucketName=''
R2__AccessKeyId=''
R2__SecretAccessKey=''
R2__Region='auto'
R2__SignedUrlMinutes='10'
Media__MaxAudioBytes='26214400'
Media__MaxImageBytes='10485760'

# VNPay (thanh toan VIP). Lay TmnCode/HashSecret trong Merchant Admin (sandbox: https://sandbox.vnpayment.vn/merchantv2/).
# ReturnUrl la URL backend VNPay dua trinh duyet ve; FrontendResultUrl la trang ket qua cua frontend Nguoi hoc (ToeicMindFE, React, dung duong dan khong dung hash).
VnPay__TmnCode=''
VnPay__HashSecret=''
VnPay__PaymentUrl='https://sandbox.vnpayment.vn/paymentv2/vpcpay.html'
VnPay__ReturnUrl='http://localhost:5078/api/vip/vnpay-return'
VnPay__FrontendResultUrl='http://localhost:5173/vip/result'

# Set the origins of the deployed frontends.
# Cors__AllowedOrigins__0='https://learn.example.com'
# Cors__AllowedOrigins__1='https://admin.example.com'

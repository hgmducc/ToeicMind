# Browser API base. Use /api with Vite's local proxy.
VITE_API_BASE_URL=/api

# Local backend target, server-side use by Vite only.
VITE_API_PROXY_TARGET=http://localhost:5078

# API request timeout in milliseconds.
# VITE_API_TIMEOUT_MS=60000

# Existing VITE_API_URL remains supported if VITE_API_BASE_URL is absent.
# VITE_API_URL=http://localhost:5078/api

# Public Google OAuth Web client ID; must match backend Google:ClientId.
VITE_GOOGLE_CLIENT_ID=
